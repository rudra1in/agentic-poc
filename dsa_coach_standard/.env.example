# ── LLM backend: "ollama" (default), "gemini" or "mock" (offline demo) ──────────
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_PLANNER_MODEL=qwen2.5-coder:7b

# Optional cheaper tier used for routing + critic when OPT model_tiering is on (T9).
# Leave empty to use OLLAMA_MODEL.  Example: llama3.2:1b
OLLAMA_SMALL_MODEL=

# Gemini (only needed when LLM_BACKEND=gemini)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SMALL_MODEL=

# ── RAG backend: "memory" (default), "pgvector", or "chroma" ─────────────────
RAG_BACKEND=memory
DATABASE_URL=postgresql://localhost/dsa_coach

# ── Token optimisation (see llm/optim.py) ────────────────────────────────────
# optimized (default) = every technique T1-T9 on;  baseline = original behaviour
OPT_PROFILE=optimized
# Switch single techniques off, e.g.:  OPT_DISABLE=response_cache,selective_critic
OPT_DISABLE=

# api (default) = use the backend's token counters;  estimate = chars/4 for prompts
TOKEN_COUNT_MODE=api
